# An app is discovered by apps/<id>/manifest.json; no central dispatch edits.
file(GLOB app_manifests CONFIGURE_DEPENDS "${PROJECT_DIR}/apps/*/manifest.json")
set(app_ordered "")
foreach(manifest IN LISTS app_manifests)
    file(READ "${manifest}" app_json)
    string(JSON order GET "${app_json}" order)
    list(APPEND app_ordered "${order}:${manifest}")
endforeach()
list(SORT app_ordered)
set(ESPHOOK_APP_SOURCES "")
set(ESPHOOK_APP_INCLUDES "")
set(catalog "#include \"esphook/app.h\"\n")
set(catalog_entries "")
foreach(entry IN LISTS app_ordered)
    string(REGEX REPLACE "^[^:]+:" "" manifest "${entry}")
    file(READ "${manifest}" app_json)
    string(JSON app_id GET "${app_json}" id)
    string(JSON required GET "${app_json}" required)
    if(NOT app_id MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid app id in ${manifest}")
    endif()
    option(ESPHOOK_APP_${app_id} "Build esphook app ${app_id}" ON)
    if(NOT ESPHOOK_APP_${app_id})
        if(required)
            message(FATAL_ERROR "Required app ${app_id} cannot be disabled")
        endif()
        continue()
    endif()
    get_filename_component(app_dir "${manifest}" DIRECTORY)
    list(APPEND ESPHOOK_APP_INCLUDES "${app_dir}/firmware")
    string(JSON source_count LENGTH "${app_json}" sources)
    math(EXPR source_last "${source_count}-1")
    foreach(index RANGE ${source_last})
        string(JSON source GET "${app_json}" sources ${index})
        list(APPEND ESPHOOK_APP_SOURCES "${app_dir}/${source}")
    endforeach()
    string(APPEND catalog "extern const app_descriptor_t esphook_app_${app_id};\n")
    string(APPEND catalog_entries "    &esphook_app_${app_id},\n")
endforeach()
string(APPEND catalog "const app_descriptor_t *const esphook_apps[] = {\n${catalog_entries}};\nconst size_t esphook_app_count = sizeof esphook_apps / sizeof esphook_apps[0];\n")
set(catalog_path "${CMAKE_CURRENT_BINARY_DIR}/esphook_app_catalog.c")
file(WRITE "${catalog_path}" "${catalog}")
list(APPEND ESPHOOK_APP_SOURCES "${catalog_path}")
