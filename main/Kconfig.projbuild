menu "Desktop follow robot"
config DESKTOP_FOLLOW_ROBOT
    bool "Include optional LD2450 / NHY009 drivers"
    default y
    help
        Build one universal image for screen-only and robot devices. The default
        runtime auto profile keeps the legacy three keys and probes radar RX only.
        Servo PWM is never initialized until robot profile is selected and the
        device restarted. GPIO10 then becomes servo output; only GPIO6 is a key.
config ROBOT_RADAR_RX_GPIO
    int "ESP UART RX GPIO (connect to LD2450 TX)"
    depends on DESKTOP_FOLLOW_ROBOT
    range 0 21
    default 20
config ROBOT_RADAR_TX_GPIO
    int "ESP UART TX GPIO (connect to LD2450 RX)"
    depends on DESKTOP_FOLLOW_ROBOT
    range 0 21
    default 21
config ROBOT_RADAR_BAUD
    int "LD2450 UART baud rate"
    depends on DESKTOP_FOLLOW_ROBOT
    range 9600 460800
    default 256000
config ROBOT_SERVO_GPIO
    int "NHY009 PWM GPIO"
    depends on DESKTOP_FOLLOW_ROBOT
    range 0 21
    default 10
config ROBOT_SERVO_HZ
    int "Servo PWM frequency (verify against your servo specification)"
    depends on DESKTOP_FOLLOW_ROBOT
    range 40 100
    default 50
    help
        50 Hz is an initial engineering setting, not a confirmed NHY009
        specification. PWM stays disabled at boot until 'robot arm'.
endmenu
